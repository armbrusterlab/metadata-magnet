<input id="syntenyInputInput" type="text">
<<button "Submit synteny input file">>
    <<set $syntenyInput = $("#syntenyInputInput").val()>>
    <<set $outputString to setup.formatInput($outputString, "syntenyInput", $syntenyInput) >>
    <<goto "synteny3">>
<</button>>


